# Use a development database. Never put real credentials in this example.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eagles?sslmode=require"
# Direct connection for migrations; on Neon use the hostname without -pooler.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/eagles?sslmode=require"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Local development uses localhost. Set AUTH_URL separately in Vercel to
# https://eagles-drama-club-register.vercel.app (and use the production domain
# for the Vercel Production environment).
AUTH_URL="http://localhost:3000"
# Leave blank locally. Set to true on Vercel, whose proxy supplies the host.
AUTH_TRUST_HOST=""
SEED_ADMIN_EMAIL="superadmin@example.test"
SEED_ADMIN_PASSWORD=""
# Later phases only; none of these is required for Phase 0 or 1.
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://YOUR_DOMAIN/api/mpesa/callback"
# Firebase Web Messaging public configuration (not credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Server-only Firebase Admin service account JSON. Never expose or commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Protects the scheduled rehearsal-reminder endpoint. Use a long random value in Vercel.
CRON_SECRET=""
# Cloudflare R2 S3 credentials and bucket. Never commit real credential values.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="auto"
AWS_BUCKET_NAME=""
